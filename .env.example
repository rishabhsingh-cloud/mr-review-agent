# ── Copy to .env and fill in. Never commit .env ──

# --- Database (Postgres + pgvector + pgvectorscale + TimescaleDB) ---
POSTGRES_USER=mragent
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mragent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async URL used by the app (asyncpg). Host is 'db' inside docker, 'localhost' from your machine.
DATABASE_URL=postgresql+asyncpg://mragent:change-me-strong-password@localhost:5432/mragent

# --- GitLab (self-hosted) ---
GITLAB_URL=https://gitlab.your-company.internal
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx            # bot user PAT / project access token, scope: api
WEBHOOK_SECRET=another-strong-random-secret        # matches the X-Gitlab-Token set on the webhook
GITLAB_SSL_VERIFY=true                              # false (or a CA bundle path) for internal/self-signed certs
GITLAB_TIMEOUT=30

# --- Trigger / authorization ---
REVIEW_COMMAND=/review                              # comment command that triggers a review
REVIEWER_ALLOWLIST=alice,bob,carol                 # comma-separated GitLab usernames; use * to allow ANY user

# --- LLM providers ---
# Project uses OpenAI for BOTH the review LLM and embeddings.
LLM_PROVIDER=openai_compat
OPENAI_API_KEY=sk-xxxxxxxx                          # review LLM + embeddings
# ANTHROPIC_API_KEY=                                # unused unless LLM_PROVIDER=anthropic
# For a local/self-hosted OpenAI-compatible endpoint (vLLM/Ollama) instead of OpenAI:
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=not-needed

# Model routing (OpenAI model IDs). Deep pass vs cheap pass.
REVIEW_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=256

# --- Cost control ---
DAILY_BUDGET_USD=25

# --- App ---
LOG_LEVEL=INFO
API_PORT=8642                                       # host port for the API/webhook (pick one free on the box)
REVIEW_CONCURRENCY=4                                # max concurrent agent calls (modest for a 2-vCPU box)
